<Window x:Class="CarGo.AdminClient.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Felhasználó szerkesztése"
        Height="520"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Név" Margin="0,0,0,4"/>
                <TextBox x:Name="NameTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Email" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Telefon" Margin="0,0,0,4"/>
                <TextBox x:Name="PhoneTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Keresztnév" Margin="0,0,0,4"/>
                <TextBox x:Name="FirstNameTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Vezetéknév" Margin="0,0,0,4"/>
                <TextBox x:Name="LastNameTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Város" Margin="0,0,0,4"/>
                <TextBox x:Name="CityTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Irányítószám" Margin="0,0,0,4"/>
                <TextBox x:Name="ZipTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Ország" Margin="0,0,0,4"/>
                <TextBox x:Name="CountryTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Cím" Margin="0,0,0,4"/>
                <TextBox x:Name="AddressTextBox" Height="32" Margin="0,0,0,12"/>

                <CheckBox x:Name="VerifiedCheckBox" Content="Hitelesítve" Margin="0,0,0,12"/>

                <TextBlock Text="Új jelszó (opcionális)" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Height="32"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Mégse" Width="120" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Mentés" Width="140" Background="#2563eb" Foreground="White" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

