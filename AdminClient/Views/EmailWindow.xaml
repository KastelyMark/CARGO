<Window x:Class="CarGo.AdminClient.Views.EmailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Email küldése"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Címzett név" Margin="0,0,0,4"/>
            <TextBox x:Name="NameTextBox" Height="32" Margin="0,0,0,12" IsReadOnly="True"/>

            <TextBlock Text="Címzett email" Margin="0,0,0,4"/>
            <TextBox x:Name="EmailTextBox" Height="32" Margin="0,0,0,12" IsReadOnly="True"/>

            <TextBlock Text="Tárgy" Margin="0,0,0,4"/>
            <TextBox x:Name="SubjectTextBox" Height="32" Margin="0,0,0,12"/>

            <TextBlock Text="Üzenet" Margin="0,0,0,4"/>
            <TextBox x:Name="MessageTextBox"
                     Height="160"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Mégse" Width="120" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Küldés" Width="140" Background="#2563eb" Foreground="White" Click="SendButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

