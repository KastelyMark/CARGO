<Window x:Class="CarGo.AdminClient.Views.CarEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autó szerkesztése"
        Height="640"
        Width="540"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Autó neve" Margin="0,0,0,4"/>
                <TextBox x:Name="NameTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Leírás" Margin="0,0,0,4"/>
                <TextBox x:Name="DescriptionTextBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Ár (Ft/nap)" Margin="0,0,0,4"/>
                <TextBox x:Name="PriceTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Kategória" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryCombo" Height="32" Margin="0,0,0,12">
                    <ComboBoxItem Content="Gazdaságos"/>
                    <ComboBoxItem Content="Kompakt"/>
                    <ComboBoxItem Content="Középkategória"/>
                    <ComboBoxItem Content="Luxus"/>
                    <ComboBoxItem Content="SUV"/>
                    <ComboBoxItem Content="Sports"/>
                </ComboBox>

                <TextBlock Text="Váltó" Margin="0,0,0,4"/>
                <ComboBox x:Name="TransmissionCombo" Height="32" Margin="0,0,0,12">
                    <ComboBoxItem Content="automatic"/>
                    <ComboBoxItem Content="manual"/>
                </ComboBox>

                <TextBlock Text="Üzemanyag" Margin="0,0,0,4"/>
                <ComboBox x:Name="FuelCombo" Height="32" Margin="0,0,0,12">
                    <ComboBoxItem Content="Benzin"/>
                    <ComboBoxItem Content="Diesel"/>
                    <ComboBoxItem Content="Hybrid"/>
                    <ComboBoxItem Content="Electric"/>
                </ComboBox>

                <TextBlock Text="Ülések" Margin="0,0,0,4"/>
                <TextBox x:Name="SeatsTextBox" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Kép" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12">
                    <TextBox x:Name="ImagePathTextBox" Height="32" IsReadOnly="True" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                    <Button Content="Tallózás" Width="120" Click="BrowseButton_Click"/>
                </DockPanel>
                <Border BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Height="180">
                    <Image x:Name="ImagePreview" Stretch="UniformToFill"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Mégse" Width="120" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Mentés" Width="140" Background="#2563eb" Foreground="White" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

