<Window x:Class="CarGo.AdminClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CarGO Admin" Height="900" Width="1400"
        MinWidth="960" MinHeight="600"
        Background="#f4f6fb"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#2563eb"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1d4ed8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Login panel -->
        <Grid x:Name="LoginPanel"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="24">

            <Border MaxWidth="460"
                    Padding="32"
                    Background="White"
                    CornerRadius="18"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="CarGO Admin"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Kérjük adja meg az admin jelszót."
                               Foreground="#6b7280"
                               Margin="0,0,0,24"/>

                    <PasswordBox x:Name="AdminPasswordBox"
                                 FontSize="16"
                                 Padding="12"
                                 Margin="0,0,0,8"/>
                    <TextBlock x:Name="LoginErrorText"
                               Foreground="#dc2626"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button Content="Kilépés"
                                Style="{StaticResource PrimaryButton}"
                                Background="#e5e7eb"
                                Foreground="#1f2937"
                                IsCancel="True"
                                Click="CloseButton_Click" Height="36" Width="142"/>
                        <Button x:Name="LoginButton"
                                Content="Bejelentkezés"
                                Style="{StaticResource PrimaryButton}"
                                IsDefault="True"
                                Click="LoginButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Admin Panel -->
        <Grid x:Name="AdminPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#0f172a" Height="102" Padding="24">
                <DockPanel>
                    <TextBlock Text="CarGO Admin Irányítópult"
                               FontSize="20"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right">
                        <TextBlock Text="{Binding StatusMessage}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#a5b4fc"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="#f87171"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Adatok frissítése"
                                Style="{StaticResource PrimaryButton}"
                                Click="RefreshButton_Click"/>
                        <Button Content="Kijelentkezés"
                                Style="{StaticResource PrimaryButton}"
                                Background="#dc2626"
                                Click="LogoutButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <TabControl x:Name="MainTabs">
                    <!-- Dashboard -->
                    <TabItem Header="Irányítópult">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <UniformGrid Columns="3" Rows="2" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                <Border Margin="10" Padding="20" Background="White" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="Felhasználók" Foreground="#6b7280"/>
                                        <TextBlock Text="{Binding Stats.Users}" FontSize="32" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Stats.RegisteredUsers, StringFormat='Hitelesített: {0}'}"
                                                   Foreground="#9ca3af"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="10" Padding="20" Background="White" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="Üzenetek" Foreground="#6b7280"/>
                                        <TextBlock Text="{Binding Stats.Messages}" FontSize="32" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Stats.NewMessages, StringFormat='Új: {0}'}"
                                                   Foreground="#9ca3af"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="10" Padding="20" Background="White" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="Bérlések" Foreground="#6b7280"/>
                                        <TextBlock Text="{Binding Stats.Rentals}" FontSize="32" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Stats.PendingRentals, StringFormat='Függő: {0}'}"
                                                   Foreground="#9ca3af"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="10" Padding="20" Background="White" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="Autók" Foreground="#6b7280"/>
                                        <TextBlock Text="{Binding Stats.Cars}" FontSize="32" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Messages -->
                    <TabItem Header="Üzenetek">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button Content="Frissítés" Style="{StaticResource PrimaryButton}" Click="RefreshMessagesButton_Click"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Messages}"
                                      SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Telefonszám" Binding="{Binding Phone}" Width="1*"/>
                                    <DataGridTextColumn Header="Üzenet" Binding="{Binding Message}" Width="2*"/>
                                    <DataGridTextColumn Header="Dátum" Binding="{Binding CreatedAt, StringFormat=yyyy.MM.dd HH:mm}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Státusz" Binding="{Binding Status}" Width="1*"/>
                                    <DataGridTemplateColumn Header="Műveletek" Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Olvasott" Style="{StaticResource PrimaryButton}" Padding="10,4"
                                                            Click="MarkMessageRead_Click"/>
                                                    <Button Content="Törlés" Style="{StaticResource PrimaryButton}" Background="#dc2626"
                                                            Padding="10,4" Click="DeleteMessage_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Users -->
                    <TabItem Header="Felhasználók">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                                <ComboBox x:Name="UserFilterCombo"
                                          Width="180"
                                          Margin="0,0,12,0"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="UserFilterCombo_SelectionChanged">
                                    <ComboBoxItem Content="Hitelesített" Tag="registered"/>
                                    <ComboBoxItem Content="Nincs hitelesítve" Tag="unverified"/>
                                    <ComboBoxItem Content="Összes" Tag="all"/>
                                </ComboBox>
                                <Button Content="Frissítés" Style="{StaticResource PrimaryButton}" Click="RefreshUsersButton_Click"/>
                                <Button Content="Szerkesztés" Style="{StaticResource PrimaryButton}" Click="EditUserButton_Click"/>
                                <Button Content="Törlés" Style="{StaticResource PrimaryButton}" Background="#dc2626" Click="DeleteUserButton_Click"/>
                                <Button Content="Email küldése" Style="{StaticResource PrimaryButton}" Click="SendEmailButton_Click"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Users}"
                                      SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="1*"/>
                                    <DataGridTextColumn Header="Regisztráció" Binding="{Binding CreatedAt, StringFormat=yyyy.MM.dd}" Width="1*"/>
                                    <DataGridTextColumn Header="Hitelesített" Binding="{Binding IsVerified}" Width="0.8*"/>
                                    <DataGridTextColumn Header="Város" Binding="{Binding City}" Width="1*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Rentals -->
                    <TabItem Header="Bérlések">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button Content="Frissítés" Style="{StaticResource PrimaryButton}" Click="RefreshRentalsButton_Click"/>
                                <Button Content="Jóváhagyás" Style="{StaticResource PrimaryButton}" Click="ApproveRentalButton_Click"/>
                                <Button Content="Elutasítás" Style="{StaticResource PrimaryButton}" Background="#f59e0b" Click="RejectRentalButton_Click"/>
                                <Button Content="Törlés" Style="{StaticResource PrimaryButton}" Background="#dc2626" Click="DeleteRentalButton_Click"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Rentals}"
                                      SelectedItem="{Binding SelectedRental, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Autó" Binding="{Binding CarName}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Ár" Binding="{Binding CarPrice}" Width="0.8*"/>
                                    <DataGridTextColumn Header="Kezdete" Binding="{Binding RentalDate, StringFormat=yyyy.MM.dd}" Width="1*"/>
                                    <DataGridTextColumn Header="Vége" Binding="{Binding ReturnDate, StringFormat=yyyy.MM.dd}" Width="1*"/>
                                    <DataGridTextColumn Header="Ügyfél" Binding="{Binding CustomerName}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding CustomerEmail}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Státusz" Binding="{Binding Status}" Width="0.8*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Cars -->
                    <TabItem Header="Autók">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button Content="Frissítés" Style="{StaticResource PrimaryButton}" Click="RefreshCarsButton_Click"/>
                                <Button Content="Új autó" Style="{StaticResource PrimaryButton}" Click="AddCarButton_Click"/>
                                <Button Content="Szerkesztés" Style="{StaticResource PrimaryButton}" Click="EditCarButton_Click"/>
                                <Button Content="Törlés" Style="{StaticResource PrimaryButton}" Background="#dc2626" Click="DeleteCarButton_Click"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Cars}"
                                      SelectedItem="{Binding SelectedCar, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.4*"/>
                                    <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Ár (Ft/nap)" Binding="{Binding PricePerDay}" Width="0.8*"/>
                                    <DataGridTextColumn Header="Kategória" Binding="{Binding Category}" Width="1*"/>
                                    <DataGridTextColumn Header="Váltó" Binding="{Binding Transmission}" Width="0.8*"/>
                                    <DataGridTextColumn Header="Üzemanyag" Binding="{Binding FuelType}" Width="0.8*"/>
                                    <DataGridTextColumn Header="Ülések" Binding="{Binding Seats}" Width="0.6*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>

                <Border Background="#80000000"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                        CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="240" Height="16" IsIndeterminate="True"/>
                        <TextBlock Text="Adatok betöltése..." Foreground="White" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
